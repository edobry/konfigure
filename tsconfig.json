{
    "compilerOptions": {
        "importHelpers": true,
        "module": "NodeNext",
        "moduleResolution": "node16",
        "rootDir": "src",
        "strict": true,
        "lib": ["ES2020", "ESNext"],
        "target": "ES2020",
        "esModuleInterop": true,
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts", "src/**/*.js"],
    "ts-node": {
        "esm": true
    }
}
